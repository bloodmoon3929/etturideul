# 비밀값과 개인 설정. 이 파일을 .env로 복사해서 쓴다(.env는 git에 올리지 않는다).

# 사진 수집 요청의 User-Agent에 넣을 연락처(이메일 또는 URL). Wikimedia API 정책상 필요하다.
# 비워 두면 Wikimedia 직접 검색은 건너뛰고 Openverse만 쓴다.
CONTACT=

# Flickr API 키. 비워 두면 Flickr 직접 검색은 건너뛴다.
FLICKR_API_KEY=

# TODO(firebase): 로그 내보내기(scripts/analyze_logs.py)가 Firestore를 읽을 때 쓸 서비스 계정 키 경로
# GOOGLE_APPLICATION_CREDENTIALS=
